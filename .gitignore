# ==============================================================================
#  核心：利希特 — 離線伺服器  .gitignore
# ==============================================================================

# ---- 執行期產物（每次跑都會變，不進版控）----
runtime/
output/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Node ----
node_modules/

# ---- 編輯器 / 系統 ----
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- 本機設定覆寫（如果你不想公開自己的 host / 路徑，改成自己的檔名）----
config/server.local.json

# ---- OBB 解包資源（3.2 GB，使用者自備）----
obb/

# ---- 內嵌執行環境（走 GitHub Release 附件，不進版控）----
#   若你想讓倉庫「解壓即用」，把下面兩行註解掉即可（倉庫會變成約 163 MB）
python/
node/

# ---- 備份 ----
*.bak
*.orig
*.tmp

# ==============================================================================
#  注意：以下「不要」加入忽略，否則使用者 clone 後會缺少必要檔案
#    config/server.json      ← 必要：伺服器設定（已是通用預設值）
#    data/decoded/           ← 必要：365 個配置表
#    data/proto/             ← 必要：64 個協定描述
#    cdn/cdnroot/            ← 必要：CDN 覆蓋檔
#    python/  node/          ← 若你選擇把執行環境一起提交
# ==============================================================================
